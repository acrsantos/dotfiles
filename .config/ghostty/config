# theme = NvimLightCustom
theme = ayu
confirm-close-surface = false
font-size = 12
font-family = "Berkeley Mono"
# font-style = Bold
window-decoration = false
window-padding-x = 0
window-padding-y = 0

background-opacity = 1.0

adjust-cell-height = 0

keybind = ctrl+alt+shift+b=write_scrollback_file:open
keybind = ctrl+shift+b=write_scrollback_file:paste

keybind = alt+one=unbind
keybind = alt+two=unbind
keybind = alt+three=unbind
keybind = alt+four=unbind
keybind = alt+five=unbind
keybind = alt+six=unbind
keybind = alt+seven=unbind
keybind = alt+eight=unbind
keybind = alt+nine=unbind

gtk-tabs-location = bottom
gtk-wide-tabs = false
# gtk-adwaita = true
# adw-toolbar-style = flat

# custom-shader = ./shaders/cursor_blaze.glsl
